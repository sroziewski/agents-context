# Copy to .env and set a long random value, e.g. `openssl rand -hex 32`.
QDRANT_API_KEY=
# Windows paths go in single quotes: unquoted, backslashes are escape sequences and the
# rest of the file is ignored.
# CTX_MODEL_DIR='D:\dev\my\agents-context\models\bge-m3-fp32'
# Auto-inject of past-session summaries into Claude Code prompts (`ctx inject on|off`).
# CTX_INJECT=off
# Per-client override (default: CTX_INJECT). The OpenCode plugin is gated here.
# CTX_INJECT_CLAUDE=off
# CTX_INJECT_OPENCODE=off
# CTX_INJECT_TEAMS_MIN_SCORE=0.65
# CTX_INJECT_TEAMS=off
# CTX_INJECT_MIN_SCORE=0.55
# Session search ranking: dense (default), hybrid, sparse. See `ctx eval`.
# CTX_SEARCH_MODE=dense
# Deep search (opt-in reranker; `ctx search --rerank`, MCP deep_search_sessions). ~17 s/query
# on CPU, so never the default. The model (~1.1 GB) caches under CTX_RERANK_CACHE_DIR.
# CTX_RERANK_MODEL=jina-v2
# CTX_RERANK_THREADS=8
# CTX_RERANK_POOL=30
# Jira (read-only by default). Data Center, Bearer Personal Access Token.
# QDRANT-style: real values live only in .env, never in the repo.
# JIRA_URL=https://jira.example.org
# JIRA_TOKEN=<personal access token>
# JIRA_PROJECTS maps project dirs to Jira keys (default: %APPDATA%\agents-context\jira-projects.json)
# WRITES ARE OFF BY DEFAULT. Turning this on still requires an explicit per-call confirm
# (CLI --write, MCP confirm:true). Leave it off to keep Jira strictly read-only.
# JIRA_WRITE=off
