{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(find *)",
      "Bash(mvn *)",
      "Bash(ls *)"
    ]
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\you\\AppData\\Local\\agents-context\\bin\\ctx.exe",
            "args": [
              "hook",
              "--source",
              "claude"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\you\\AppData\\Local\\agents-context\\bin\\ctx.exe",
            "args": [
              "hook",
              "--source",
              "claude"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\you\\AppData\\Local\\agents-context\\bin\\ctx.exe",
            "args": [
              "hook",
              "--source",
              "claude"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\you\\AppData\\Local\\agents-context\\bin\\ctx.exe",
            "args": [
              "hook",
              "--inject"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\you\\AppData\\Local\\agents-context\\bin\\ctx.exe",
            "args": [
              "hook",
              "--source",
              "claude"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "javascript-typescript@claude-code-workflows": true,
    "backend-development@claude-code-workflows": true,
    "python-development@claude-code-workflows": true,
    "security-scanning@claude-code-workflows": true,
    "kubernetes-operations@claude-code-workflows": true,
    "cloud-infrastructure@claude-code-workflows": true,
    "comprehensive-review@claude-code-workflows": true,
    "full-stack-orchestration@claude-code-workflows": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-code-workflows": {
      "source": {
        "source": "github",
        "repo": "wshobson/agents"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "type": "command",
    "command": "C:/Users/you/AppData/Local/agents-context/bin/ctx.exe statusline",
    "padding": 0
  }
}
